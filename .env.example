# Mẫu biến môi trường — KHÔNG chứa giá trị thật.
# Copy sang .env.local rồi điền. .env.local bị git bỏ qua; file này thì không.

# Chuỗi kết nối POOLED của Neon — app dùng lúc chạy.
# Hostname có hậu tố "-pooler" ở nhãn đầu tiên. Đây là dấu hiệu phân biệt duy
# nhất giữa hai endpoint, và src/lib/db.ts kiểm tra đúng chỗ đó rồi throw ngay
# khi module được nạp nếu chuỗi không phải pooled (INFRA-06).
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Chuỗi kết nối TRỰC TIẾP (không qua pooler) của Neon — cùng database, khác host:
# không có "-pooler". Hai giá trị này không được giống nhau, nếu giống thì việc
# cắm nhầm chỗ sẽ không còn phát hiện được nữa.
#
# Điều dễ chẩn đoán sai: biến này bắt buộc cho MỌI lệnh CLI của prisma, kể cả
# `prisma generate` — lệnh không hề đụng tới database. Bộ nạp config phân giải
# nó ngay lập tức và throw khi thiếu, nên nếu quên khai báo thì build sẽ hỏng
# với một thông báo không nhắc gì tới Vercel lẫn migration.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Khóa ký session của Auth.js. Sinh bằng: npx auth secret
AUTH_SECRET=""

# OAuth client lấy từ Google Cloud Console > APIs & Services > Credentials.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Để Auth.js tin host mà Vercel forward tới (proxy đứng trước app).
AUTH_TRUST_HOST="true"

# Đầu vào của seed, dạng email[:nhãn] phân tách bằng dấu phẩy.
# Ví dụ: "an@example.com:An,binh@example.com:Bình"
ALLOWLIST_EMAILS=""
